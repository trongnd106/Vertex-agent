# ============================================================================
# Vertex Agent Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values. All variables have sensible
# defaults; only DATABASE_URL and API keys are typically required for production.

# ============================================================================
# Model Configuration (REQUIRED for production)
# ============================================================================

# LLM model provider and model ID (format: provider:model-id)
# Examples: openai:gpt-4o-mini, anthropic:claude-3-5-sonnet-20241022
# Default: openai:gpt-4o-mini
AGENT_MODEL=openai:gpt-4o-mini

# OpenAI API key (required if using OpenAI models)
# Get from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# Anthropic API key (required if using Claude/Anthropic models)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ============================================================================
# Database Configuration (optional; in-memory used if not set)
# ============================================================================

# PostgreSQL connection string for persistent state and long-term memory
# Format: postgresql://user:password@host:port/dbname
# If not set, agent uses in-memory session storage (data lost on restart)
# Example: postgresql://vertex_user:secure_password@localhost:5432/vertex_agent
DATABASE_URL=

# ============================================================================
# Session Management
# ============================================================================

# Maximum age (days) before stale threads/sessions are cleaned up
# Default: 30
# Minimum: 1
STALE_THREAD_MAX_AGE_DAYS=30

# ============================================================================
# Long-Term Memory (Dreaming)
# ============================================================================

# Heartbeat interval (seconds) for the dreaming consolidation background job
# Controls how frequently long-term memory summaries are created
# Default: 3600 (1 hour)
# Minimum: 60
DREAMING_HEARTBEAT_MAX_AGE_SECONDS=3600

# Maximum number of experience entries to consolidate in a single dreaming pass
# Higher values = more comprehensive summaries, but more compute per pass
# Default: 50
# Minimum: 1
DREAMING_MAX_BACKLOG=50

# Age (days) after which dreamed/consolidated memories become eligible for archive
# Controls retention of old summaries before they're archived or deleted
# Default: 30
# Minimum: 1
DREAMING_STALE_AFTER_DAYS=30

# ============================================================================
# Context Management (Token and Output Limits)
# ============================================================================

# Token count at which context summarization is triggered
# When message history exceeds this token count, oldest messages are summarized
# Default: 20000
# Typical range: 10000-50000 depending on model context window
SUMMARIZATION_TRIGGER_TOKENS=20000

# Number of recent messages to keep when summarizing context
# Ensures recent interactions are always available in full detail
# Default: 6
# Minimum: 1
SUMMARIZATION_KEEP_MESSAGES=6

# Maximum length (characters) for tool output in context
# Long tool outputs are truncated to this length to preserve tokens
# Default: 4000
# Minimum: 100
TOOL_OUTPUT_MAX_LENGTH=4000

# ============================================================================
# Sandbox Execution (Code/Script Execution Timeouts)
# ============================================================================

# Default timeout (seconds) for sandbox code execution
# Prevents runaway scripts from blocking the agent
# Default: 30
# Minimum: 5
SANDBOX_DEFAULT_TIMEOUT_SECONDS=30

# ============================================================================
# Rate Limiting
# ============================================================================

# Token bucket capacity (requests) for rate limiting
# Maximum number of requests allowed in the refill period
# Default: 5.0
# Typical range: 1-100 depending on throughput requirements
RATE_LIMIT_CAPACITY=5.0

# Token bucket refill rate (requests per second)
# How quickly tokens are replenished after being consumed
# Default: 1.0 (1 request per second)
# Example: 0.5 = one request every 2 seconds, 10.0 = 10 requests per second
RATE_LIMIT_REFILL_RATE=1.0

# ============================================================================
# Optional Tools and Integrations
# ============================================================================

# Tavily API key for web search tool
# Required only if the agent needs to search the web
# Get from: https://tavily.com/
# Leave blank to disable web search functionality
TAVILY_API_KEY=

# ============================================================================
# Observability (LangSmith Tracing)
# ============================================================================

# Enable LangSmith tracing for debugging and monitoring
# Logs all agent runs, tool calls, and model interactions to LangSmith
# Default: false
# Set to 'true' to enable tracing
LANGSMITH_TRACING=false

# LangSmith API key (required if LANGSMITH_TRACING=true)
# Get from: https://smith.langchain.com/
# Leave blank to disable tracing
LANGSMITH_API_KEY=

# LangSmith project name for organizing traces
# All traces will be grouped under this project in LangSmith dashboard
# Default: vertex-agent
# Must be a valid project name in your LangSmith workspace
LANGSMITH_PROJECT=vertex-agent
