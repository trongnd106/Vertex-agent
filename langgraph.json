{
  "python_version": "3.11",
  "graphs": {
    "agent": "./src/agent/server.py:graph"
  },
  "env": {
    "AGENT_MODEL": "${AGENT_MODEL:-DeepSeek-V4-Flash}",
    "DATABASE_URL": "${DATABASE_URL:-postgresql://deepagents:deepagents@localhost:5432/deepagents}",
    "REDIS_URL": "${REDIS_URL:-redis://localhost:6379/0}",
    "LANGSMITH_TRACING": "${LANGSMITH_TRACING:-false}",
    "LANGSMITH_ENDPOINT": "https://api.smith.langchain.com",
    "LANGSMITH_PROJECT": "${LANGSMITH_PROJECT:-vertex-agent}"
  },
  "dependencies": ["."],
  "checkpointer": "postgres",
  "store": {
    "index": {
      "embed": "openai:text-embedding-3-small",
      "dims": 1536,
      "fields": ["text"]
    }
  }
}